# ── データベース（compose.yml の postgres）──────────────
DATABASE_URL=postgresql://wardrobase:wardrobase@localhost:5433/wardrobase

# ── better-auth ────────────────────────────────────────
# 生成コマンド: openssl rand -base64 32
BETTER_AUTH_SECRET=<openssl rand -base64 32 で生成した値>
BETTER_AUTH_URL=http://localhost:3000
# 新規登録の許可（開発環境専用。fail-closed: true のときだけ開く）。
# 本番ビルドでは環境変数に関係なく常時封鎖される（signupPolicy.ts）。
# 本番アカウントは `npm run user:create` の管理スクリプトで作成する
AUTH_ALLOW_SIGNUP=false
# 開発環境で登録を許可するメールアドレス（カンマ区切り）。
# 未設定なら誰も登録できない。ローカル開発では "*"（全許可）にする
AUTH_SIGNUP_ALLOWED_EMAILS=
# ポートフォリオ閲覧用デモアカウント（閲覧のみ・書き込み不可）。
# 両方設定するとログイン画面に「デモを見る」ボタンが出る。未設定なら無効
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# シード（prisma/seed-demo.ts）でデモへ複製しないコーデの着用日。
# カンマ区切りの YYYY-MM-DD
SEED_EXCLUDE_WORN_ON=

# ── S3互換ストレージ（compose.yml の minio）─────────────
# 本番では R2 / S3 のエンドポイントとキーに差し替える
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wardrobase-items
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── 開発用メールサーバー（compose.yml の mailpit）────────
SMTP_HOST=localhost
SMTP_PORT=1025
