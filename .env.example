# ── データベース（compose.yml の postgres）──────────────
DATABASE_URL=postgresql://wardrobase:wardrobase@localhost:5433/wardrobase

# ── better-auth ────────────────────────────────────────
# 生成コマンド: openssl rand -base64 32
BETTER_AUTH_SECRET=<openssl rand -base64 32 で生成した値>
BETTER_AUTH_URL=http://localhost:3000
# 新規登録の封鎖（自分専用運用）。本番は true にし、
# 自分のアカウントを作るときだけ一時的に false にする
AUTH_DISABLE_SIGNUP=false
# ポートフォリオ閲覧用デモアカウント（閲覧のみ・書き込み不可）。
# 両方設定するとログイン画面に「デモを見る」ボタンが出る。未設定なら無効
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
# シード（prisma/seed-demo.ts）でデモへ複製しないコーデの着用日。
# カンマ区切りの YYYY-MM-DD
SEED_EXCLUDE_WORN_ON=

# ── S3互換ストレージ（compose.yml の minio）─────────────
# 本番では R2 / S3 のエンドポイントとキーに差し替える
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=wardrobase-items
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# ── 開発用メールサーバー（compose.yml の mailpit）────────
SMTP_HOST=localhost
SMTP_PORT=1025
